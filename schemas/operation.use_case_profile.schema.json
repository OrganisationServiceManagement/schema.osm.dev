{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.osm.dev/schemas/operation.use_case_profile.schema.json",
  "title": "operation.use_case_profile",
  "type": "object",
  "required": [
    "id",
    "type",
    "canonical_key",
    "name",
    "version",
    "status",
    "use_case",
    "smetions",
    "perception_types",
    "command_catalog",
    "approval_model",
    "validation_rules",
    "workflow"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "type": {
      "const": "operation.use_case_profile"
    },
    "canonical_key": {
      "$ref": "common.schema.json#/$defs/canonical_key"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "$ref": "common.schema.json#/$defs/lifecycle_status"
    },
    "use_case": {
      "$ref": "operation.use_case.schema.json"
    },
    "smetions": {
      "type": "array",
      "items": {
        "$ref": "automation.smetion.schema.json"
      },
      "minItems": 1
    },
    "perception_types": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/perception_type"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "command_catalog": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/command_type"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "approval_model": {
      "type": "object",
      "required": [
        "approval_policy_ref",
        "risk_group_approval_states",
        "command_commit_states",
        "required_decider_roles",
        "material_change_reapproval_required"
      ],
      "properties": {
        "approval_policy_ref": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "risk_group_approval_states": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "candidate",
              "under_review",
              "selected",
              "approved",
              "mitigation_planning_allowed"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "command_commit_states": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "proposed",
              "precondition_validated",
              "schema_validated",
              "policy_validated",
              "impact_analysed",
              "staged",
              "approval_required",
              "approved",
              "committed"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "required_decider_roles": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ref"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "material_change_reapproval_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "validation_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule",
          "severity"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/canonical_key"
          },
          "rule": {
            "$ref": "common.schema.json#/$defs/markdown"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error",
              "blocking"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step",
          "name",
          "description"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "$ref": "common.schema.json#/$defs/markdown"
          },
          "actor_refs": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/ref"
            },
            "uniqueItems": true
          },
          "input_types": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/type_ref"
            },
            "uniqueItems": true
          },
          "output_types": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/type_ref"
            },
            "uniqueItems": true
          },
          "commands": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/command_type"
            },
            "uniqueItems": true
          },
          "approval_gate": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "$ref": "common.schema.json#/$defs/markdown"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
